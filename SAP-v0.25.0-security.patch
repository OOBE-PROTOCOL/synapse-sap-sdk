-                    from: depositor_info,
-                    to: escrow_info,
-                },
-            ),
-            amount,
-        )?;
-    }
-
-    // Phase 3: Mutable state update
-    let escrow = &mut ctx.accounts.escrow;
-    escrow.balance = escrow.balance
-        .checked_add(amount)
-        .ok_or(error!(SapError::ArithmeticOverflow))?;
-    escrow.total_deposited = escrow.total_deposited
