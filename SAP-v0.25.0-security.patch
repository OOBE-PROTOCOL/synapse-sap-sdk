-    escrow.balance = escrow.balance
-        .checked_sub(withdraw_amount)
-        .ok_or(error!(SapError::ArithmeticOverflow))?;
-
-    emit!(EscrowWithdrawnEvent {
-        escrow: escrow.key(),
