{
  "name": "@oobe-protocol-labs/synapse-sap-sdk",
  "version": "0.19.6",
  "description": "Synapse Agent Protocol (SAP) SDK for Solana — v0.19.6 Next.js + Node.js dual-format (FINAL)",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js"
    },
    "./types": {
      "types": "./dist/cjs/types.d.ts",
      "require": "./dist/cjs/types.js",
      "import": "./dist/esm/types.js"
    },
    "./pdas": {
      "types": "./dist/cjs/pdas/index.d.ts",
      "require": "./dist/cjs/pdas/index.js",
      "import": "./dist/esm/pdas/index.js"
    },
    "./instructions": {
      "types": "./dist/cjs/instructions/index.d.ts",
      "require": "./dist/cjs/instructions/index.js",
      "import": "./dist/esm/instructions/index.js"
    },
    "./accounts": {
      "types": "./dist/cjs/accounts/index.d.ts",
      "require": "./dist/cjs/accounts/index.js",
      "import": "./dist/esm/accounts/index.js"
    },
    "./events": {
      "types": "./dist/cjs/events/index.d.ts",
      "require": "./dist/cjs/events/index.js",
      "import": "./dist/esm/events/index.js"
    },
    "./utils": {
      "types": "./dist/cjs/utils/index.d.ts",
      "require": "./dist/cjs/utils/index.js",
      "import": "./dist/esm/utils/index.js"
    },
    "./errors": {
      "types": "./dist/cjs/errors/index.d.ts",
      "require": "./dist/cjs/errors/index.js",
      "import": "./dist/esm/errors/index.js"
    },
    "./constants": {
      "types": "./dist/cjs/constants/index.d.ts",
      "import": "./dist/esm/constants/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./types": {
      "types": "./dist/esm/types.d.ts",
      "import": "./dist/esm/types.js",
      "require": "./dist/cjs/types.js"
    },
    "./pdas": {
      "types": "./dist/esm/pdas/index.d.ts",
      "import": "./dist/esm/pdas/index.js",
      "require": "./dist/cjs/pdas/index.js"
    },
    "./instructions": {
      "types": "./dist/esm/instructions/index.d.ts",
      "import": "./dist/esm/instructions/index.js",
      "require": "./dist/cjs/instructions/index.js"
    },
    "./accounts": {
      "types": "./dist/esm/accounts/index.d.ts",
      "import": "./dist/esm/accounts/index.js",
      "require": "./dist/cjs/accounts/index.js"
    },
    "./events": {
      "types": "./dist/esm/events/index.d.ts",
      "import": "./dist/esm/events/index.js",
      "require": "./dist/cjs/events/index.js"
    },
    "./utils": {
      "types": "./dist/esm/utils/index.d.ts",
      "import": "./dist/esm/utils/index.js",
      "require": "./dist/cjs/utils/index.js"
    }
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json",
    "postbuild": "node scripts/fix-esm-imports.js",
    "clean": "rm -rf dist",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "solana",
    "anchor",
    "escrow",
    "agentic",
    "x402",
    "payments",
    "dispute",
    "staking",
    "synapse",
    "sap"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.3",
    "bs58": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
