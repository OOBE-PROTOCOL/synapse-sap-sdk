{
  "name": "@oobe-protocol-labs/synapse-sap-sdk",
  "version": "1.0.3",
  "description": "Synapse Agent Protocol (SAP) SDK for Solana | v1.0.3 legacy pricing menu migration",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./types": {
      "types": "./dist/esm/types/index.d.ts",
      "import": "./dist/esm/types/index.js",
      "require": "./dist/cjs/types/index.js"
    },
    "./pdas": {
      "types": "./dist/esm/pdas/index.d.ts",
      "import": "./dist/esm/pdas/index.js",
      "require": "./dist/cjs/pdas/index.js"
    },
    "./pda": {
      "types": "./dist/esm/pda/index.d.ts",
      "import": "./dist/esm/pda/index.js",
      "require": "./dist/cjs/pda/index.js"
    },
    "./core": {
      "types": "./dist/esm/core/index.d.ts",
      "import": "./dist/esm/core/index.js",
      "require": "./dist/cjs/core/index.js"
    },
    "./core/*": {
      "types": "./dist/esm/core/*.d.ts",
      "import": "./dist/esm/core/*.js",
      "require": "./dist/cjs/core/*.js"
    },
    "./client": {
      "types": "./dist/esm/client.d.ts",
      "import": "./dist/esm/client.js",
      "require": "./dist/cjs/client.js"
    },
    "./constants": {
      "types": "./dist/esm/constants/index.d.ts",
      "import": "./dist/esm/constants/index.js",
      "require": "./dist/cjs/constants/index.js"
    },
    "./constants/*": {
      "types": "./dist/esm/constants/*.d.ts",
      "import": "./dist/esm/constants/*.js",
      "require": "./dist/cjs/constants/*.js"
    },
    "./idl": {
      "types": "./dist/esm/idl/index.d.ts",
      "import": "./dist/esm/idl/index.js",
      "require": "./dist/cjs/idl/index.js"
    },
    "./idl/synapse_agent_sap.json": {
      "import": "./dist/esm/idl/synapse_agent_sap.json",
      "require": "./dist/cjs/idl/synapse_agent_sap.json"
    },
    "./instructions": {
      "types": "./dist/esm/instructions/index.d.ts",
      "import": "./dist/esm/instructions/index.js",
      "require": "./dist/cjs/instructions/index.js"
    },
    "./instructions/*": {
      "types": "./dist/esm/instructions/*.d.ts",
      "import": "./dist/esm/instructions/*.js",
      "require": "./dist/cjs/instructions/*.js"
    },
    "./accounts": {
      "types": "./dist/esm/accounts/index.d.ts",
      "import": "./dist/esm/accounts/index.js",
      "require": "./dist/cjs/accounts/index.js"
    },
    "./modules": {
      "types": "./dist/esm/modules/index.d.ts",
      "import": "./dist/esm/modules/index.js",
      "require": "./dist/cjs/modules/index.js"
    },
    "./modules/*": {
      "types": "./dist/esm/modules/*.d.ts",
      "import": "./dist/esm/modules/*.js",
      "require": "./dist/cjs/modules/*.js"
    },
    "./registries": {
      "types": "./dist/esm/registries/index.d.ts",
      "import": "./dist/esm/registries/index.js",
      "require": "./dist/cjs/registries/index.js"
    },
    "./registries/*": {
      "types": "./dist/esm/registries/*.d.ts",
      "import": "./dist/esm/registries/*.js",
      "require": "./dist/cjs/registries/*.js"
    },
    "./events": {
      "types": "./dist/esm/events/index.d.ts",
      "import": "./dist/esm/events/index.js",
      "require": "./dist/cjs/events/index.js"
    },
    "./events/*": {
      "types": "./dist/esm/events/*.d.ts",
      "import": "./dist/esm/events/*.js",
      "require": "./dist/cjs/events/*.js"
    },
    "./parser": {
      "types": "./dist/esm/parser/index.d.ts",
      "import": "./dist/esm/parser/index.js",
      "require": "./dist/cjs/parser/index.js"
    },
    "./parser/*": {
      "types": "./dist/esm/parser/*.d.ts",
      "import": "./dist/esm/parser/*.js",
      "require": "./dist/cjs/parser/*.js"
    },
    "./plugin": {
      "types": "./dist/esm/plugin/index.d.ts",
      "import": "./dist/esm/plugin/index.js",
      "require": "./dist/cjs/plugin/index.js"
    },
    "./plugin/*": {
      "types": "./dist/esm/plugin/*.d.ts",
      "import": "./dist/esm/plugin/*.js",
      "require": "./dist/cjs/plugin/*.js"
    },
    "./postgres": {
      "types": "./dist/esm/postgres/index.d.ts",
      "import": "./dist/esm/postgres/index.js",
      "require": "./dist/cjs/postgres/index.js"
    },
    "./postgres/*": {
      "types": "./dist/esm/postgres/*.d.ts",
      "import": "./dist/esm/postgres/*.js",
      "require": "./dist/cjs/postgres/*.js"
    },
    "./utils": {
      "types": "./dist/esm/utils/index.d.ts",
      "import": "./dist/esm/utils/index.js",
      "require": "./dist/cjs/utils/index.js"
    },
    "./utils/*": {
      "types": "./dist/esm/utils/*.d.ts",
      "import": "./dist/esm/utils/*.js",
      "require": "./dist/cjs/utils/*.js"
    },
    "./errors": {
      "types": "./dist/esm/errors/index.d.ts",
      "import": "./dist/esm/errors/index.js",
      "require": "./dist/cjs/errors/index.js"
    }
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json",
    "postbuild": "node scripts/fix-esm-imports.js",
    "clean": "rm -rf dist",
    "test": "vitest",
    "verify:release": "node scripts/verify-release.mjs",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "solana",
    "anchor",
    "escrow",
    "agentic",
    "x402",
    "payments",
    "dispute",
    "staking",
    "synapse",
    "sap"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.3",
    "bs58": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "ws": "^8.21.0"
  },
  "engines": {
    "node": ">=18"
  }
}
